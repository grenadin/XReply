<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.twitter.android" />
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.XReply">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.XReply"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReplyActivity"
            android:icon="@drawable/ic_share"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.XReply"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <intent-filter
                android:icon="@drawable/ic_share"
                android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WebReplyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.XReply.Web" />
        <activity
            android:name=".ReplySentCard"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.XReply.ReplySentCard" />
    </application>
</manifest>
